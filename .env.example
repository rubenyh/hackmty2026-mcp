# PostgreSQL URL for a dedicated read-only role. Direct and session-pooler URLs are supported.
# Keep TLS enabled. Never use the Supabase postgres role or put a service-role API key here.
SUPABASE_DATABASE_URL=postgresql://mcp_reader:REPLACE_WITH_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Session-pooler example (copy the exact region, project reference, and port from Supabase):
# SUPABASE_DATABASE_URL=postgresql+psycopg://mcp_reader.PROJECT_REF:REPLACE_WITH_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Comma-separated PostgreSQL schemas. At least one valid schema is required.
MCP_ALLOWED_SCHEMAS=public
# Exact comma-separated tables/views. Empty means deny all. Unqualified names are allowed only
# when MCP_ALLOWED_SCHEMAS contains exactly one schema.
MCP_ALLOWED_TABLES=public.customers,public.accounts,public.transactions

# Row limits: both must be positive, default must not exceed max, and max is capped at 10000.
MCP_DEFAULT_LIMIT=50
MCP_MAX_LIMIT=200
# Per-transaction PostgreSQL statement timeout in milliseconds (100-60000).
MCP_STATEMENT_TIMEOUT_MS=5000

# Transport is stdio or http. Host and port are used by the http transport.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
